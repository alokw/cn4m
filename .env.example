# .env.example
# Copy this file to .env and fill in your values before running cn4m.
# .env is gitignored — never commit it, as it contains credentials.

# ── Folders ───────────────────────────────────────────────────────────────────
# Full path on your host machine to a single workspace folder that contains
# 'repo' and 'quarantine' as subdirectories:
#
#   C:\path\to\workspace\
#       repo\           ← media deliveries land here
#       quarantine\     ← files moved here when quarantined
#
# Both folders must be under a single parent so quarantining is a fast rename
# instead of a slow byte-copy across separate Docker bind mounts.
WORKSPACE_FOLDER='C:\path\to\your\workspace'

# Your local timezone, used to stamp correct local times on sheet entries.
# e.g. America/Los_Angeles, America/New_York, Europe/London
TZ='America/Los_Angeles'

# ── Google Sheets ─────────────────────────────────────────────────────────────
# GOOGLE_SHEET: the ID from your sheet's URL:
#   https://docs.google.com/spreadsheets/d/<ID>/edit
# GOOGLE_CREDS: paste the entire contents of your service account JSON key file
#   as a single line (no line breaks inside the value).
GOOGLE_SHEET='your-google-sheet-id-here'
GOOGLE_CREDS='{ "type": "service_account", "project_id": "...", "private_key": "...", ... }'

# ── Discord notifications ─────────────────────────────────────────────────────
# Optional — if unset, Discord notifications are silently skipped.
# In Discord: Edit Channel → Integrations → Webhooks → New Webhook → Copy Webhook URL
DISCORD_WEBHOOK_URL='https://discord.com/api/webhooks/...'

# ── Scanning ──────────────────────────────────────────────────────────────────
# Files and filenames to skip during scanning. This list covers common artifacts
# from robocopy, FreeFileSync, Aspera, disguise/d3, and macOS.
# Add any project-specific filenames you want ignored (comma-separated).
# Glob-style wildcards are supported: e.g. videoin_*.mov, *.tmp, ~private-*
# Matching is case-insensitive. macOS resource forks (._*) are always excluded.
EXCLUDE_FILES='ROBOCOPY.RCJ, D3_bpc_16-9.d, desktop.ini, .DS_Store, assets.json, .sync.ffs_db, sync.ffs_db, sync.ffs_lock, Thumbs.db, videoin_*.mov, ada.jpg, george.jpg, ACES2065-1_ColorChecker2014.exr, D3_color_16-9.png, D3_color_4-3.png, D3_test_16-9.png, D3_test_4-3.png, ~private-asp'

# Folder names to skip entirely during scanning. Same wildcard + case-insensitive
# matching as EXCLUDE_FILES. Excluded folders aren't even descended into. Optional.
EXCLUDE_FOLDERS='~private-asp*'

# ── QC checks ─────────────────────────────────────────────────────────────────
# All three are optional and independent — leave blank (or omit) to skip a check.
# Matching is case-insensitive. Failing cells turn red in the UI and Google Sheet.

# Allowed codecs, comma-separated.
QC_CODEC='NotchLC, Hap'

# Per-screen resolution rules as SCREEN@WxH entries, comma-separated.
# The screen ID is matched against the screen field parsed from the filename.
# Width and height are checked independently — only the failing dimension turns red.
QC_RESOLUTION='A1@112x336, B1@224x448, HD@1920x1080'

# Allowed framerates, comma-separated (matched within 0.001 for float precision).
QC_FPS='29.97, 30'

# ── Flask / Celery ────────────────────────────────────────────────────────────
# TIME_BETWEEN_CHECKS: small delay (seconds) between processing each file.
#   Keeps Celery progress updates responsive in the UI. Default: 0.001
TIME_BETWEEN_CHECKS=0.001

# SECRET_KEY: random string for Flask session security.
#   Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY='replace-this-with-a-random-string'

# These are set automatically by docker-compose — no need to change them.
# CELERY_BROKER_URL=redis://redis:6379/0
# RESULT_BACKEND=redis://redis:6379/0
