# .env.example
# Copy this file to .env and fill in your values before running cn4m.
# .env is gitignored — never commit it, as it contains credentials.

# ── Folders ───────────────────────────────────────────────────────────────────
# Full paths on your host machine. Docker mounts these into the container.
REPO_FOLDER='C:\path\to\your\media\delivery\folder'
QUAR_FOLDER='C:\path\to\your\quarantine\folder'

# ── Google Sheets ─────────────────────────────────────────────────────────────
# GOOGLE_SHEET: the ID from your sheet's URL:
#   https://docs.google.com/spreadsheets/d/<ID>/edit
# GOOGLE_CREDS: paste the entire contents of your service account JSON key file
#   as a single line (no line breaks inside the value).
GOOGLE_SHEET='your-google-sheet-id-here'
GOOGLE_CREDS='{ "type": "service_account", "project_id": "...", "private_key": "...", ... }'

# ── Discord notifications ─────────────────────────────────────────────────────
# Optional — if either value is missing, Discord notifications are silently skipped.
# DISCORD_BOT_TOKEN: from the Discord Developer Portal → your app → Bot
# DISCORD_CHANNEL_ID: right-click the target channel in Discord → Copy Channel ID
DISCORD_BOT_TOKEN=your-bot-token-here
DISCORD_CHANNEL_ID=your-channel-id-here

# ── Scanning ──────────────────────────────────────────────────────────────────
# Files and filenames to skip during scanning. This list covers common artifacts
# from robocopy, FreeFileSync, Aspera, disguise/d3, and macOS.
# Add any project-specific filenames you want ignored (comma-separated).
EXCLUDE_FILES='ROBOCOPY.RCJ, D3_bpc_16-9.d, desktop.ini, .DS_Store, assets.json, .sync.ffs_db, sync.ffs_db, sync.ffs_lock, Thumbs.db, videoin_1.mov, videoin_2.mov, videoin_3.mov, videoin_4.mov, videoin_5.mov, videoin_6.mov, videoin_7.mov, videoin_8.mov, videoin_9.mov, videoin_10.mov, videoin_11.mov, videoin_12.mov, videoin_13.mov, videoin_14.mov, videoin_15.mov, videoin_16.mov, ada.jpg, george.jpg, ACES2065-1_ColorChecker2014.exr, D3_color_16-9.png, D3_color_4-3.png, D3_test_16-9.png, D3_test_4-3.png, ~private-asp'

# ── Flask / Celery ────────────────────────────────────────────────────────────
# TIME_BETWEEN_CHECKS: small delay (seconds) between processing each file.
#   Keeps Celery progress updates responsive in the UI. Default: 0.001
TIME_BETWEEN_CHECKS=0.001

# SECRET_KEY: random string for Flask session security.
#   Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY='replace-this-with-a-random-string'

# These are set automatically by docker-compose — no need to change them.
# CELERY_BROKER_URL=redis://redis:6379/0
# RESULT_BACKEND=redis://redis:6379/0
